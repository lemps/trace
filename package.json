{
  "name": "trace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:recording": "tsc && vite build --mode recording",
    "check:recording": "node scripts/check-recording-bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check src",
    "typecheck": "tsc --noEmit",
