{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for trace's own webview only. It names the webview, not the window: the Browser tab's pages are child webviews of the main window and must get nothing.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "dialog:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-html"
  ]
}
